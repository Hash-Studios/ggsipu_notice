#!/usr/bin/env node
// ggsipu_notice's independent-review CLI.
//
//   tool/harness/review preflight
//   tool/harness/review packet            # print the reviewer's input, for a human
//   tool/harness/review run [--mode standard|adversarial]
//   tool/harness/review check
//   tool/harness/review adjudicate --finding <id> --status resolved|rejected \
//                                  --by opus|fable|user --decision <decision-id> \
//                                  --rationale <text>
//
// Review is OPTIONAL in this repo. It is required only on the five paths where a mistake
// escapes this checkout — server-new/functions/main.py (pushes FCM to every device, and a
// push cannot be un-sent), lib/main.dart (FCM/OneSignal setup and the fcm_tokens write),
// .gitignore (guards lib/keys.dart, google-services.json and key.jks from git history),
// android/app/build.gradle (release signing) and pubspec.yaml (a dependency shipped inside
// a published app). See `review:` in .claude/docs/routing.yaml. Most changes here need
// none.
//
// THE RULE: `run` never writes a passing review it did not obtain. If the Codex CLI is
// absent, unauthenticated, on the wrong model, or fails mid-run, it writes an
// `incomplete` review.json carrying the reason — which blocks completion — and exits
// non-zero. There is no path from "review unavailable" to "review passed".

import { createHash } from "node:crypto";
import { existsSync, readFileSync, mkdirSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const RUNTIME_LIB = process.env.CLAUDE_HARNESS_RUNTIME || join(homedir(), ".claude", "harness", "runtime", "lib");

// Which reviewer model this repo pins. Change here and in docs/agents/verification.md.
// Pinned, with no environment override by design: Sol is the only reviewer, and the
// model is verified after the fact from the Codex session rollout. An overridable
// constant would let `reviewer.model` in review.json assert a model that never ran.
const REQUIRED_MODEL = "gpt-5.6-sol";

async function runtime(name) {
  const path = join(RUNTIME_LIB, name);
  if (!existsSync(path)) die(`harness runtime module not found: ${path}\nSet CLAUDE_HARNESS_RUNTIME or reinstall the harness.`);
  return import(pathToFileURL(path).href);
}

function die(msg, code = 2) {
  process.stderr.write(`tool/harness/review: ${msg}\n`);
  process.exit(code);
}

function flag(argv, name) {
  const i = argv.indexOf(name);
  return i === -1 ? undefined : argv[i + 1];
}

async function context() {
  const { resolveWorktreeRoot } = await runtime("reporoot.mjs");
  const ts = await runtime("taskstate.mjs");
  const { computeDiff } = await runtime("diff.mjs");
  const { workspaceFingerprint } = await runtime("fingerprint.mjs");
  const { FINGERPRINT_EXCLUDE_PREFIXES } = await import(pathToFileURL(join(here, "lib", "classify.mjs")).href);
  const rp = await import(pathToFileURL(join(here, "lib", "reviewpolicy.mjs")).href);
  const pk = await import(pathToFileURL(join(here, "lib", "reviewpacket.mjs")).href);

  const rooted = resolveWorktreeRoot({ cwd: process.cwd() });
  if (!rooted.ok) die(rooted.reason);
  const cwd = rooted.root;

  const taskId = ts.readActiveTaskId({ cwd });
  if (taskId === null) die("no active task (tool/harness/task start <task-id>)");
  const stateRead = ts.readState({ cwd, taskId });
  if (!stateRead.ok) die(`active task "${taskId}" has an unreadable state.json (${stateRead.error})`);

  const diff = computeDiff({ cwd, baseRefArg: undefined, filesOverride: undefined });
  const changedEntries = diff.changedFiles ?? [];
  const dir = ts.taskDir({ cwd, taskId });

  return {
    cwd,
    taskId,
    dir,
    state: stateRead.state,
    diff,
    changedEntries,
    rp,
    pk,
    workspaceFp: workspaceFingerprint({ cwd, changedFiles: changedEntries, excludePrefixes: FINGERPRINT_EXCLUDE_PREFIXES }),
    policyReviewMode: rp.requiredReviewMode(changedEntries.map((e) => e.path)).mode,
  };
}

function artifactFingerprint(path) {
  try {
    return `sha256:${createHash("sha256").update(readFileSync(path)).digest("hex")}`;
  } catch {
    return undefined;
  }
}

function writeArtifact(dir, name, obj) {
  mkdirSync(dir, { recursive: true });
  const path = join(dir, name);
  writeFileSync(path, `${JSON.stringify(obj, null, 2)}\n`);
  return path;
}

function baseReview({ taskId, mode, workspaceFp, verifyFp, packetFp, policyFp, contentFp }) {
  return {
    schema_version: 1,
    task_id: taskId,
    reviewer: { provider: "codex", model: REQUIRED_MODEL, model_source: "unverified", rollout_path: "", cli_version: "unknown" },
    mode,
    round: 1,
    workspace_fingerprint: workspaceFp,
    verification_artifact_fingerprint: verifyFp,
    review_input_fingerprint: packetFp,
    review_policy_fingerprint: policyFp,
    review_input_content_fingerprint: contentFp,
    status: "incomplete",
    incomplete_reason: "REVIEW_INCOMPLETE",
    findings: [],
    escalation_required: false,
    duration_ms: 0,
    usage: { input_tokens: 0, output_tokens: 0 },
  };
}

const ABSENT_FP = `sha256:${"0".repeat(64)}`;

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];

  if (cmd === undefined || cmd === "-h" || cmd === "--help") {
    process.stdout.write(
      "usage:\n" +
        "  tool/harness/review preflight\n" +
        "  tool/harness/review packet\n" +
        "  tool/harness/review run [--mode standard|adversarial]\n" +
        "  tool/harness/review check\n" +
        "  tool/harness/review adjudicate --finding <id> --status resolved|rejected --by opus|fable|user --decision <id> --rationale <text>\n",
    );
    process.exit(cmd === undefined ? 2 : 0);
  }

  if (cmd === "preflight") {
    const cx = await runtime("codexclient.mjs");
    const r = cx.solPreflight({ requiredModel: REQUIRED_MODEL });
    process.stdout.write(`${JSON.stringify(r, null, 2)}\n`);
    process.exit(r.ok ? 0 : 1);
  }

  const ctx = await context();
  const mode = flag(argv, "--mode") ?? (ctx.policyReviewMode === "none" ? "standard" : ctx.policyReviewMode);
  const packetText = ctx.pk.buildPacket({ cwd: ctx.cwd, taskId: ctx.taskId, base: ctx.diff.base, changedEntries: ctx.changedEntries, mode, tier: ctx.state.required_tier });

  if (cmd === "packet") {
    process.stdout.write(packetText);
    return;
  }

  const verifyFp = artifactFingerprint(join(ctx.dir, "verify.json")) ?? ABSENT_FP;
  const packetFp = ctx.pk.fingerprintOf(packetText);
  const policyFp = ctx.rp.reviewPolicyFingerprint({ cwd: ctx.cwd });
  const contentFp = ctx.pk.reviewInputContentFingerprint({ cwd: ctx.cwd, taskId: ctx.taskId });

  if (cmd === "check") {
    const { evaluateGate } = await import(pathToFileURL(join(here, "lib", "gatecheck.mjs")).href);
    const d = await evaluateGate({ cwd: ctx.cwd });
    process.stdout.write(`${JSON.stringify(d, null, 2)}\n`);
    process.exit(d.decision === "allow" ? 0 : 1);
  }

  if (cmd === "run") {
    if (!["standard", "adversarial"].includes(mode)) die(`--mode must be standard or adversarial (got "${mode}")`);
    const cx = await runtime("codexclient.mjs");
    const artifact = baseReview({ taskId: ctx.taskId, mode, workspaceFp: ctx.workspaceFp, verifyFp, packetFp, policyFp, contentFp });

    const pre = cx.solPreflight({ requiredModel: REQUIRED_MODEL });
    if (!pre.ok) {
      artifact.incomplete_reason = pre.reason_code;
      const path = writeArtifact(ctx.dir, "review.json", artifact);
      process.stderr.write(`review unavailable (${pre.reason_code}): ${pre.detail}\nwrote an incomplete review artifact: ${path}\n`);
      process.exit(1);
    }
    artifact.reviewer.cli_version = pre.cliVersion;

    const schemaPath = join(tmpdir(), `ggsipu-notice-review-schema-${process.pid}.json`);
    writeFileSync(schemaPath, `${JSON.stringify(cx.OUTPUT_SCHEMA, null, 2)}\n`);
    const outFile = join(tmpdir(), `ggsipu-notice-review-out-${process.pid}.txt`);

    const run = cx.runCodexReview({ cwd: ctx.cwd, packetText, schemaPath, outFile, requiredModel: REQUIRED_MODEL });
    artifact.duration_ms = run.durationMs ?? 0;
    if (!run.ok) {
      artifact.incomplete_reason = run.reason_code;
      const path = writeArtifact(ctx.dir, "review.json", artifact);
      process.stderr.write(`review did not complete (${run.reason_code}): ${run.detail}\nwrote an incomplete review artifact: ${path}\n`);
      process.exit(1);
    }
    artifact.usage = run.usage;

    const verified = cx.verifyModelFromRollout({ threadId: run.threadId, requiredModel: REQUIRED_MODEL });
    if (!verified.ok) {
      artifact.incomplete_reason = verified.reason_code;
      const path = writeArtifact(ctx.dir, "review.json", artifact);
      process.stderr.write(`could not confirm the reviewer model (${verified.reason_code}): ${verified.detail}\nwrote an incomplete review artifact: ${path}\n`);
      process.exit(1);
    }
    artifact.reviewer.model = verified.model;
    artifact.reviewer.model_source = "rollout";
    artifact.reviewer.rollout_path = verified.rolloutPath;

    let parsed;
    try {
      parsed = JSON.parse(run.finalMessage);
    } catch {
      artifact.incomplete_reason = "REVIEW_MALFORMED";
      const path = writeArtifact(ctx.dir, "review.json", artifact);
      process.stderr.write(`the reviewer's final message was not JSON.\nwrote an incomplete review artifact: ${path}\n`);
      process.exit(1);
    }
    artifact.status = parsed.status;
    artifact.incomplete_reason = parsed.status === "incomplete" ? "REVIEW_INCOMPLETE" : null;
    artifact.findings = Array.isArray(parsed.findings) ? parsed.findings : [];
    artifact.escalation_required = artifact.findings.some((f) => f.severity === "blocker" || f.severity === "major");

    const { validateReviewArtifact } = await runtime("reviewcheck.mjs");
    const v = validateReviewArtifact(artifact);
    if (!v.ok) {
      // The reviewer returned something that does not satisfy the contract. Record that
      // honestly as incomplete rather than writing an artifact the gate would reject
      // with a confusing reason.
      const salvage = baseReview({ taskId: ctx.taskId, mode, workspaceFp: ctx.workspaceFp, verifyFp, packetFp, policyFp, contentFp });
      salvage.reviewer = artifact.reviewer;
      salvage.incomplete_reason = "REVIEW_MALFORMED";
      salvage.duration_ms = artifact.duration_ms;
      salvage.usage = artifact.usage;
      const path = writeArtifact(ctx.dir, "review.json", salvage);
      process.stderr.write(`the reviewer's output did not satisfy the review contract (${v.reason}).\nwrote an incomplete review artifact: ${path}\n`);
      process.exit(1);
    }

    const path = writeArtifact(ctx.dir, "review.json", artifact);
    process.stdout.write(`review ${artifact.status} (${artifact.findings.length} finding(s), mode ${mode})\n${path}\n`);
    process.exit(artifact.status === "pass" ? 0 : 1);
  }

  if (cmd === "adjudicate") {
    const finding = flag(argv, "--finding");
    const status = flag(argv, "--status");
    const by = flag(argv, "--by");
    const decision = flag(argv, "--decision");
    const rationale = flag(argv, "--rationale");
    const adj = await runtime("adjudication.mjs");
    if (!finding || !status || !by || !decision || !rationale) die("adjudicate needs --finding, --status, --by, --decision and --rationale");
    if (!adj.FINDING_STATUSES.includes(status)) die(`--status must be one of ${adj.FINDING_STATUSES.join(", ")}`);
    if (!adj.ADJUDICATORS.includes(by)) die(`--by must be one of ${adj.ADJUDICATORS.join(", ")} — an implementer agent may never adjudicate its own review`);

    const reviewPath = join(ctx.dir, "review.json");
    if (!existsSync(reviewPath)) die("no review.json to adjudicate");
    const reviewFp = artifactFingerprint(reviewPath);
    const existingPath = join(ctx.dir, "adjudication.json");
    let existing = { findings: [] };
    if (existsSync(existingPath)) {
      try {
        existing = JSON.parse(readFileSync(existingPath, "utf8"));
      } catch {
        die("the existing adjudication.json is not valid JSON — fix or remove it first");
      }
    }

    const artifact = {
      schema_version: 1,
      task_id: ctx.taskId,
      source_review_fingerprint: reviewFp,
      workspace_fingerprint: ctx.workspaceFp,
      verification_artifact_fingerprint: verifyFp,
      adjudicator: by,
      round: JSON.parse(readFileSync(reviewPath, "utf8")).round ?? 1,
      updated_at: new Date().toISOString(),
      findings: adj.mergeFindingEntry(existing.findings, { id: finding, status, decision_ref: decision, rationale }),
    };
    const v = adj.validateAdjudicationArtifact(artifact);
    if (!v.ok) die(`refusing to write a malformed adjudication.json (${v.reason})`);
    const path = writeArtifact(ctx.dir, "adjudication.json", artifact);
    process.stdout.write(`adjudicated ${finding} as ${status} by ${by} (${decision})\n${path}\n`);
    process.stdout.write(`note: decision "${decision}" must exist in ${join(ctx.dir, "decisions.md")} or the gate will refuse it.\n`);
    return;
  }

  die(`unknown subcommand "${cmd}"`);
}

main().catch((e) => {
  process.stderr.write(`tool/harness/review: ${e?.stack ?? e}\n`);
  process.exit(2);
});
