#!/usr/bin/env node
// ggsipu_notice's task lifecycle CLI. See .claude/tasks/README.md.
//
//   tool/harness/task start <task-id> [--tier fast|normal|full] [--review none|standard|adversarial]
//   tool/harness/task state <planning|working|awaiting_user|verifying|reviewing>
//   tool/harness/task ready
//   tool/harness/task complete
//   tool/harness/task show [--json]
//   tool/harness/task list
//   tool/harness/task abandon
//
// state.json is written ONLY through the runtime's taskstate.mjs — no subcommand here
// hand-crafts that JSON. `complete` is gated: it runs tool/harness/gate's decision and
// refuses unless it allows. There is no --force.

import { cpSync, existsSync, mkdirSync, readdirSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const RUNTIME_LIB = process.env.CLAUDE_HARNESS_RUNTIME || join(homedir(), ".claude", "harness", "runtime", "lib");

const TIERS = ["fast", "normal", "full"];
const REVIEW_MODES = ["none", "standard", "adversarial"];
const SETTABLE_STATES = ["planning", "working", "awaiting_user", "verifying", "reviewing"];

async function runtime(name) {
  const path = join(RUNTIME_LIB, name);
  if (!existsSync(path)) die(`harness runtime module not found: ${path}\nSet CLAUDE_HARNESS_RUNTIME or reinstall the harness.`, 2);
  return import(pathToFileURL(path).href);
}

function die(msg, code = 2) {
  process.stderr.write(`tool/harness/task: ${msg}\n`);
  process.exit(code);
}

function flag(argv, name) {
  const i = argv.indexOf(name);
  return i === -1 ? undefined : argv[i + 1];
}

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  const ts = await runtime("taskstate.mjs");
  const { resolveWorktreeRoot } = await runtime("reporoot.mjs");

  const rooted = resolveWorktreeRoot({ cwd: process.cwd() });
  if (!rooted.ok) die(rooted.reason, 2);
  const cwd = rooted.root;

  const requireActive = () => {
    const id = ts.readActiveTaskId({ cwd });
    if (id === null) die("no active task (tool/harness/task start <task-id>)", 2);
    const read = ts.readState({ cwd, taskId: id });
    if (!read.ok) die(`active task "${id}" has an unreadable state.json (${read.error})`, 2);
    return read.state;
  };

  switch (cmd) {
    case "start": {
      const taskId = argv[1];
      if (!taskId || taskId.startsWith("-")) die("usage: tool/harness/task start <task-id> [--tier <t>] [--review <mode>]");
      const tier = flag(argv, "--tier") ?? "normal";
      const review = flag(argv, "--review") ?? "none";
      if (!TIERS.includes(tier)) die(`--tier must be one of ${TIERS.join(", ")}`);
      if (!REVIEW_MODES.includes(review)) die(`--review must be one of ${REVIEW_MODES.join(", ")}`);

      const existing = ts.readActiveTaskId({ cwd });
      if (existing !== null && existing !== taskId) die(`task "${existing}" is already active — finish or abandon it first`);

      const dir = ts.taskDir({ cwd, taskId });
      mkdirSync(dir, { recursive: true });
      const template = join(cwd, ".claude", "tasks", "_template");
      for (const f of ["brief.md", "plan.md"]) {
        if (!existsSync(join(dir, f)) && existsSync(join(template, f))) cpSync(join(template, f), join(dir, f));
      }
      if (!existsSync(join(dir, "decisions.md"))) writeFileSync(join(dir, "decisions.md"), `# Decisions: ${taskId}\n\n<!-- D1, D2, ... one heading each. Referenced by id from adjudication.json. -->\n`);

      ts.writeState({ cwd, state: { task_id: taskId, state: "planning", required_tier: tier, review: { required: review !== "none", mode: review, round: 1 } } });
      ts.writeActiveTaskId({ cwd, taskId });
      process.stdout.write(`started ${taskId} (tier ${tier}, review ${review})\n  ${dir}\n`);
      return;
    }

    case "state": {
      const next = argv[1];
      if (!SETTABLE_STATES.includes(next)) die(`state must be one of ${SETTABLE_STATES.join(", ")} (use "ready"/"complete" for the last two)`);
      const state = requireActive();
      ts.writeState({ cwd, state: { ...state, state: next } });
      process.stdout.write(`${state.task_id}: ${state.state} -> ${next}\n`);
      return;
    }

    case "ready": {
      const state = requireActive();
      ts.writeState({ cwd, state: { ...state, state: "ready_to_complete" } });
      process.stdout.write(`${state.task_id}: ${state.state} -> ready_to_complete\n(now run: tool/harness/task complete)\n`);
      return;
    }

    case "complete": {
      const state = requireActive();
      const { evaluateGate } = await import(pathToFileURL(join(here, "lib", "gatecheck.mjs")).href);
      const decision = await evaluateGate({ cwd });
      if (decision.decision !== "allow") {
        process.stderr.write(`refusing to complete ${state.task_id}: ${decision.reason_code}\n${decision.message ?? ""}\n`);
        process.exit(1);
      }
      ts.writeState({ cwd, state: { ...state, state: "complete" } });
      ts.clearActiveTaskId({ cwd });
      process.stdout.write(`completed ${state.task_id}\n`);
      return;
    }

    case "abandon": {
      const state = requireActive();
      ts.clearActiveTaskId({ cwd });
      process.stdout.write(`abandoned ${state.task_id} (state left at "${state.state}"; its directory is untouched)\n`);
      return;
    }

    case "show": {
      const state = requireActive();
      if (argv.includes("--json")) process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
      else process.stdout.write(`${state.task_id}\n  state:  ${state.state}\n  tier:   ${state.required_tier}\n  review: ${state.review.mode} (required=${state.review.required}, round ${state.review.round})\n`);
      return;
    }

    case "list": {
      const root = join(cwd, ".claude", "tasks");
      const active = ts.readActiveTaskId({ cwd });
      const entries = existsSync(root) ? readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory() && d.name !== "_template") : [];
      if (entries.length === 0) process.stdout.write("(no tasks)\n");
      for (const d of entries) {
        const read = ts.readState({ cwd, taskId: d.name });
        const label = read.ok ? read.state.state : `unreadable (${read.error})`;
        process.stdout.write(`${d.name === active ? "* " : "  "}${d.name}  ${label}\n`);
      }
      return;
    }

    default:
      process.stdout.write(
        "usage:\n" +
          "  tool/harness/task start <task-id> [--tier fast|normal|full] [--review none|standard|adversarial]\n" +
          `  tool/harness/task state <${SETTABLE_STATES.join("|")}>\n` +
          "  tool/harness/task ready\n" +
          "  tool/harness/task complete\n" +
          "  tool/harness/task show [--json]\n" +
          "  tool/harness/task list\n" +
          "  tool/harness/task abandon\n",
      );
      process.exit(cmd === undefined || cmd === "-h" || cmd === "--help" ? 0 : 2);
  }
}

main().catch((e) => {
  process.stderr.write(`tool/harness/task: ${e?.stack ?? e}\n`);
  process.exit(2);
});
