#!/bin/sh
# harness-stable-wrapper v1 — tool/harness/verify
# Contains no harness logic and never changes for a core release: it hands this repo's root to
# the global core, which reads .claude/harness/config.json (+ adapter.mjs) and does the work.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
exec "${HARNESS_HOME:-$HOME/.claude/harness}/bin/harness" verify --repo "$root" "$@"
